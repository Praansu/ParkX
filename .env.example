# ParkX — Environment Configuration
# Copy to .env and fill in your values

BLYNK_TOKEN=your_blynk_token_here
BLYNK_BASE=https://blynk.cloud/external/api

OLLAMA_ACTIVE=true
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30

GROQ_ACTIVE=false
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

DB_PATH=parking.db
PORT=8000

ALERT_EMAIL_FROM=
ALERT_EMAIL_PASS=
ALERT_EMAIL_TO=

# Payments — leave PAYMENTS_MODE=test until you hold merchant credentials
# (registered company + PAN). Test mode moves no real money.
PAYMENTS_MODE=test
PAYMENTS_GATEWAY=test
KHALTI_SECRET_KEY=
KHALTI_BASE=https://dev.khalti.com
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_SANDBOX=true

# Operator auth — set once, restart, then REMOVE the key from this file.
# The key hash is stored in the DB; the raw key is printed at boot.
ADMIN_API_KEY=
